# Publiczny adres HTTPS aplikacji (w trakcie testów: adres z `ngrok http 8000`)
PUBLIC_BASE_URL=https://twoj-adres.ngrok-free.app

# Twilio -> Console -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numer Twilio, z którego dzwonimy (format E.164)
TWILIO_FROM_NUMBER=+48xxxxxxxxx
# Nadawca SMS-a, gdy klient nie odbiera: numer z obsługą SMS albo alfanumeryczna nazwa (max 11 znaków). Puste = bez SMS
TWILIO_SMS_FROM=
# Tryb rozmowy:
#   gather - działa na koncie trial (Twilio rozpoznaje wypowiedź, potem czyta odpowiedź; krótka pauza między turami)
#   relay  - ConversationRelay: płynna rozmowa, wymaga konta płatnego i akceptacji AI/ML Addendum
VOICE_MODE=gather
# Głos w trybie gather (inne polskie: Google.pl-PL-Chirp3-HD-Charon, Google.pl-PL-Wavenet-F, Polly.Ola-Neural)
SAY_VOICE=Google.pl-PL-Chirp3-HD-Aoede
# Wykrywanie poczty głosowej. Na koncie trial ustaw false (komunikat Twilio przed rozmową może je zmylić)
MACHINE_DETECTION=false
# Opcjonalnie, tryb relay: ID głosu ElevenLabs. Puste = domyślny polski głos Twilio
TTS_VOICE=

# Google Calendar: plik klucza konta usługi i kalendarze doradców (po przecinku)
GOOGLE_CREDENTIALS_FILE=credentials/service-account.json
GOOGLE_CALENDAR_IDS=doradca1@firma.pl,doradca2@firma.pl

# Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Sonnet 5.5 odpowiada w rozmowie ok. 1 s szybciej niż Opus 5.5 (zmierzone 2026-10-02)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low

# f = asystentka (głos żeński, np. Google.pl-PL-Chirp3-HD-Aoede), m = asystent (głos męski)
ASSISTANT_GENDER=f
COMPANY_NAME=Twoja Firma Ubezpieczeniowa
# Numer podawany w SMS-ie ("prosimy o kontakt: ..."). Puste = bez numeru
CONTACT_PHONE=
TIMEZONE=Europe/Warsaw

# Harmonogram (minuty)
CALL_LEAD_MINUTES=60
MIN_LEAD_MINUTES=15
MAX_ATTEMPTS=3
RETRY_DELAY_MINUTES=10
POLL_SECONDS=60

DB_PATH=data/calls.db
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=zmien-to-haslo
